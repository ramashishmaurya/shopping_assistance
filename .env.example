# ==============================================================================
# AI Smart Shopping Assistant — Environment Configuration
# ==============================================================================

PORT=8000

# ------------------------------------------------------------------------------
# Database Configuration
# Default: Uses built-in local SQL database (data/shopping_assistant.db) with 1000 products.
# 
# When you create a PostgreSQL database (e.g. Neon.tech, Supabase, or Local Postgres):
# Uncomment the line below and paste your database URL:
# ------------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/shopping_assistant

# Optional: Multiple Databases (Uncomment if using multiple separate databases)
# CATALOG_DATABASE_URL=postgresql://postgres:password@localhost:5432/catalog_db
# ORDERS_DATABASE_URL=postgresql://postgres:password@localhost:5432/orders_db

# ------------------------------------------------------------------------------
# LLM API Keys (Optional - Free mode works offline without keys)
# ------------------------------------------------------------------------------
GROQ_API_KEY=
OPENAI_API_KEY=
