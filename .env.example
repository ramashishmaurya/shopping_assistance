# ==============================================================================
# AI Smart Shopping Assistant — Environment Configuration
# ==============================================================================

# Server Port
PORT=8000

# ------------------------------------------------------------------------------
# PostgreSQL Database URLs
# ------------------------------------------------------------------------------
# Primary Database (Default)
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shopping_assistant

# Optional: Multiple Databases (Multi-Engine Binds)
# If your architecture splits catalog and orders into separate databases:
CATALOG_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/catalog_db
ORDERS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orders_db

# ------------------------------------------------------------------------------
# AI LLM Provider Keys (Optional - Free Mode runs offline without keys)
# ------------------------------------------------------------------------------
GROQ_API_KEY=
OPENAI_API_KEY=
